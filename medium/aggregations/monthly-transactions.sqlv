/*
=============================================================
Problem: Monthly Transactions I
Difficulty: Medium
Concepts: DATE_FORMAT, GROUP BY, Conditional Aggregation

Problem Summary:
    Calculate monthly transaction counts and amounts,
    including approved transaction metrics, by country.

Approach:
    1. Extract year and month using DATE_FORMAT.
    2. Group records by month and country.
    3. Calculate total transactions and amounts.
    4. Use conditional SUM to calculate approved metrics.
=============================================================
*/

SELECT
    DATE_FORMAT(trans_date, '%Y-%m') AS month,
    country,
    COUNT(*) AS trans_count,
    SUM(amount) AS trans_total_amount,
    SUM(CASE WHEN state = 'approved' THEN 1 ELSE 0 END) AS approved_count,
    SUM(CASE WHEN state = 'approved' THEN amount ELSE 0 END) AS approved_total_amount
FROM Transactions
GROUP BY
    DATE_FORMAT(trans_date, '%Y-%m'),
    country;